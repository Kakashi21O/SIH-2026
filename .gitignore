# Environment variables & secrets
.env
.env.local

# SQLite Database files (keep seed JSONs tracked)
data/*.db
*.db
*.sqlite3

# Python cache & artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Ignore all markdown files except README.md
*.md
**/*.md
!README.md

# SafeSteps Docs / Presentation (if excluded)
SAFE-STEPS.pptx

Project Architecture Infographic.png

# Frontend files ONLY live in frontend/ — never in root
# The backend serves static files from frontend/ (see backend/main.py line 50)
# Root-level *.js / *.css / *.html are always duplicate orphans
/*.js
/*.css
/*.html