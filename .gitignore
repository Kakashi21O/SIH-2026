# Environment variables & secrets
.env
.env.local

# SQLite Database files (keep seed JSONs tracked)
data/*.db
*.db
*.sqlite3

# Python cache & artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Ignore all markdown files except README.md
*.md
**/*.md
!README.md

# SafeSteps Docs / Presentation (if excluded)
SAFE-STEPS.pptx
